---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

const { title, tabLabel = 'index.astro', current = '' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="A blog about code, written like one." />
  </head>
  <body>
    <div class="app">
      <Sidebar current={current} />
      <div class="main">
        <div class="tabbar">
          <div class="dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <span class="tab">{tabLabel}</span>
        </div>
        <div class="mobile-note">~/blog $ tap a file above to navigate</div>
        <slot />
      </div>
    </div>
  </body>
</html>
